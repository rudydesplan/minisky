{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minisky.local/schemas/plugin-catalog-v0.json",
  "title": "MiniSky in-tree plugin catalog v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "plugins"],
  "properties": {
    "format": { "const": "minisky-plugin-catalog" },
    "version": { "const": 0 },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "protocolVersion", "execution", "domains", "source", "sha256"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
          "version": { "type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
          "protocolVersion": { "const": "minisky.plugin/v0" },
          "execution": { "const": "in-tree" },
          "domains": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "source": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
        }
      }
    }
  }
}
